# External CRM
CRM_URL=http://localhost:9000
CRM_MAX_INTENTOS=3
CRM_TIMEOUT_SEGUNDOS=2.0
CRM_BACKOFF_BASE=0.5

# Database (SQLite by default; PostgreSQL example: postgresql+psycopg://user:pass@localhost:5432/solicitudes)
DATABASE_URL=sqlite:///./solicitudes.db

# Language model (leave empty to use the fake model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Price in USD per million tokens
PRECIO_INPUT_POR_MILLON=0.15
PRECIO_OUTPUT_POR_MILLON=0.60
